# AI Connection Configuration (Standard OpenAI-compatible format)
# Works with OpenAI, Groq, DeepSeek, OpenRouter, Ollama, vLLM, etc.
OPENAI_API_KEY=sk-your_openai_api_key_here

# Custom Base URL (Optional - defaults to https://api.openai.com/v1)
# Examples:
#   Groq:       https://api.groq.com/openai/v1
#   DeepSeek:   https://api.deepseek.com
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# AI Model Configuration (Default: gpt-4o-mini)
# Examples: gpt-4o-mini, gpt-4o, llama-3.3-70b-versatile, deepseek-chat
DEFAULT_MODEL=gpt-4o-mini

# Legacy Groq Key Support (backward compatible, auto-routes to Groq endpoint)
# GROQ_API_KEY=gsk_your_groq_api_key_here

# GitHub Personal Access Token (Optional, increases API rate limits from 60 to 5000 req/hr)
GITHUB_TOKEN=ghp_your_github_token_here

# Max repositories to fetch and pass to LLM for gap analysis
MAX_REPOS_TO_ANALYZE=50
MIN_RELEVANCE_THRESHOLD=50
