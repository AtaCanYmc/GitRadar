# Groq API Key (Required for LLM features)
GROQ_API_KEY=gsk_your_groq_api_key_here

# GitHub Personal Access Token (Optional, increases API rate limits from 60 to 5000 req/hr)
GITHUB_TOKEN=ghp_your_github_token_here

# LLM Model Configuration (Default: groq/llama-3.3-70b-versatile)
DEFAULT_MODEL=groq/llama-3.3-70b-versatile

# Max repositories to fetch and pass to LLM for gap analysis
MAX_REPOS_TO_ANALYZE=50
